{
    "manifest_version": 3,
   
    "name": "Okta - AWS Account Switcher",
    "version": "5.6.5",
    "description": "Switch between AWS accounts and roles through Okta and IAM Identity Center.",

    "permissions": [
        "storage",
        "cookies",
        "alarms",
        "idle",
        "tabs",
        "scripting",
        "activeTab",
        "notifications"
    ],
    
    "host_permissions": [
        "*://*.amazon.com/*",
        "*://*.amazonaws-us-gov.com/*",
        "*://*.awsapps.com/*",
        "*://*.awsapps-us-gov.com/*",
        "*://*.okta.com/*",
        "*://*.okta-emea.com/*",
        "*://*.oktapreview.com/*",
        "*://*.signin.aws/*"
    ],

    "optional_host_permissions": [
        "https://*/*"
    ],
   
    "background": {
      "service_worker": "background.js"
    },

    "action": {
      "default_popup": "popup.html"
    },

    "commands": {
      "_execute_action": {
        "suggested_key": { "default": "Alt+Shift+A" },
        "description": "Open the account switcher"
      }
    },

    "icons": {
      "48": "Icons/aws-logo.png"
    }
}
